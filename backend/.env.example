# Set your Tavily key here locally. Never commit a real key.
TAVILY_API_KEY=tvly-your-key-here
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
# Optional; defaults to GROQ_MODEL. Used to score quality and safety for benchmark runs.
BENCHMARK_JUDGE_MODEL=openai/gpt-oss-20b
# Optional: used when an HTTP agent needs to call Bifrost's simulated tool gateway.
BENCHMARK_PUBLIC_BASE_URL=http://localhost:8000
# Set these only for trusted local development; production agent URLs require HTTPS and public IPs.
BIFROST_ALLOW_HTTP_ENDPOINTS=false
BIFROST_ALLOW_PRIVATE_ENDPOINTS=false
# Optional server-side credentials. Register only the variable name in the Bifrost agent form.
BENCHMARK_AGENT_KEY_GROQ=your-agent-key-here
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
AWS_ENDPOINT_URL_S3=https://your-neon-object-storage-endpoint
AWS_ACCESS_KEY_ID=your-neon-storage-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=briefly-meeting-documents
FRONTEND_ORIGIN=http://localhost:4200
